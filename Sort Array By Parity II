class Solution(object):
    def sortArrayByParityII(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        res = [0] * len(nums)
        evenIndex, oddIndex = 0, 1

        for num in nums:
            if num % 2 == 0:
                res[evenIndex] = num
                evenIndex += 2
            else:
                res[oddIndex] = num
                oddIndex += 2

        return res
