class Solution(object):
    def searchRange(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """

        ans=[]
        
        
        if target not in nums:
            return [-1,-1]

        for i in range(len(nums)):
            if nums[i]==target:
                ans.append(i)


           

        return (ans[0],ans[-1])

            

        
                
