class Solution(object):
    def replaceDigits(self, s):
        """
        :type s: str
        :rtype: str
        """
        result = ""

        for i in range(len(s)):
            
        
            if i % 2 == 0:
                result += s[i]
            
            else:
                ch = s[i - 1]
                digit = int(s[i])

                
                new_char = chr(ord(ch) + digit)

                result += new_char

        return result
