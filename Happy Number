class Solution(object):
    def isHappy(self, n):
        """
        :type n: int
        :rtype: bool
        """

        h=set()

        while n!=1:
            sum =0

            while n!=0:
                r=n%10
                n=n//10
                sum=sum+(r*r)

            if sum in h:
                return False

            h.add(sum)
            n=sum

        return True
        
        
