class Solution(object):
    def isIsomorphic(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """
        h = {}

        for i in range(len(s)):
    
            if s[i] in h and h[s[i]] != t[i]:
                return False
                break

            elif s[i] not in h and t[i] in h.values():
                return False
                break

            else:
                h[s[i]] = t[i]

        else:
            return True
           
